/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://disqus.com https://*.disqus.com https://c.disquscdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://*.disquscdn.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://*.supabase.co https://*.disqus.com https://*.disquscdn.com; connect-src 'self' https://*.supabase.co https://disqus.com https://*.disqus.com https://*.disquscdn.com; frame-src https://disqus.com https://*.disqus.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# O service worker nunca fica em cache: as atualizações do site chegam na hora
/sw.js
  Cache-Control: no-cache
